# =============================================================================
# ResolveAgent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before starting the stack.
# Variables with defaults are optional.
# =============================================================================

# =============================================================================
# General / Build
# =============================================================================
# Image version tag (default: dev for build, latest for pull)
RESOLVEAGENT_VERSION=latest
# Container registry (default: ghcr.io/ai-guru-global)
DOCKER_REGISTRY=ghcr.io/ai-guru-global

# =============================================================================
# Server - Platform Service Ports
# =============================================================================
# Platform HTTP port exposed on host (default: 8080)
PLATFORM_HTTP_PORT=8080
# Platform gRPC port exposed on host (default: 9090)
PLATFORM_GRPC_PORT=9090

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Database host (default: postgres - the compose service name)
RESOLVEAGENT_DATABASE_HOST=postgres
# Database port (default: 5432)
RESOLVEAGENT_DATABASE_PORT=5432
# Database user (default: resolveagent)
RESOLVEAGENT_DATABASE_USER=resolveagent
# [REQUIRED] Database password - NO DEFAULT, you must set this
RESOLVEAGENT_DATABASE_PASSWORD=your-password-here
# Database name (default: resolveagent)
RESOLVEAGENT_DATABASE_DBNAME=resolveagent
# SSL mode: disable, require, verify-ca, verify-full (default: disable)
RESOLVEAGENT_DATABASE_SSLMODE=disable
# PostgreSQL port exposed on host (default: 5432)
POSTGRES_PORT=5432

# =============================================================================
# Redis
# =============================================================================
# Redis address (default: redis:6379)
RESOLVEAGENT_REDIS_ADDR=redis:6379
# Redis password (default: empty - no auth)
RESOLVEAGENT_REDIS_PASSWORD=
# Redis database number (default: 0)
RESOLVEAGENT_REDIS_DB=0
# Redis port exposed on host (default: 6379)
REDIS_PORT=6379
# Redis max memory limit (default: 256mb)
REDIS_MAXMEMORY=256mb

# =============================================================================
# NATS
# =============================================================================
# NATS server URL (default: nats://nats:4222)
RESOLVEAGENT_NATS_URL=nats://nats:4222
# NATS client port exposed on host (default: 4222)
NATS_CLIENT_PORT=4222
# NATS monitoring port exposed on host (default: 8222)
NATS_MONITOR_PORT=8222

# =============================================================================
# Runtime - Agent Service
# =============================================================================
# Runtime gRPC address for platform to connect (default: runtime:9091)
RESOLVEAGENT_RUNTIME_GRPC_ADDR=runtime:9091
# Runtime gRPC port exposed on host (default: 9091)
RUNTIME_GRPC_PORT=9091
# Maximum agent pool size (default: 100)
RESOLVEAGENT_AGENT_POOL_MAX_SIZE=100
# Agent selection strategy: round_robin, hybrid, least_loaded (default: hybrid)
RESOLVEAGENT_SELECTOR_DEFAULT_STRATEGY=hybrid
# Confidence threshold for selector (default: 0.7)
RESOLVEAGENT_SELECTOR_CONFIDENCE_THRESHOLD=0.7

# =============================================================================
# LLM API Keys (Runtime)
# =============================================================================
# [REQUIRED for AI features] Qwen API key
RESOLVEAGENT_LLM_QWEN_API_KEY=
# Wenxin (Baidu) API key
RESOLVEAGENT_LLM_WENXIN_API_KEY=
# Zhipu (GLM) API key
RESOLVEAGENT_LLM_ZHIPU_API_KEY=

# =============================================================================
# Gateway
# =============================================================================
# Enable gateway mode (default: false)
RESOLVEAGENT_GATEWAY_ENABLED=false
# Gateway admin API URL
RESOLVEAGENT_GATEWAY_ADMIN_URL=
# Gateway config sync interval (default: 30s)
RESOLVEAGENT_GATEWAY_SYNC_INTERVAL=30s
# Enable model-based routing (default: true)
RESOLVEAGENT_GATEWAY_MODEL_ROUTING_ENABLED=true
# Default model for routing (default: qwen-plus)
RESOLVEAGENT_GATEWAY_MODEL_ROUTING_DEFAULT_MODEL=qwen-plus
# Enable gateway authentication (default: false)
RESOLVEAGENT_GATEWAY_AUTH_ENABLED=false
# JWT secret for gateway auth (required if auth enabled)
RESOLVEAGENT_GATEWAY_AUTH_JWT_SECRET=
# Load balancer strategy (default: round_robin)
RESOLVEAGENT_GATEWAY_LOAD_BALANCER_STRATEGY=round_robin

# =============================================================================
# Telemetry
# =============================================================================
# Enable OpenTelemetry (default: false)
RESOLVEAGENT_TELEMETRY_ENABLED=false
# OTLP collector endpoint (required if telemetry enabled)
RESOLVEAGENT_TELEMETRY_OTLP_ENDPOINT=

# =============================================================================
# Web UI
# =============================================================================
# WebUI port exposed on host (default: 3000)
WEBUI_PORT=3000
